{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "message",
  "description": "A letter in a window of its own: reading and answering it, its attachments and plugins; no managing of mailboxes, plugins, updates or settings",
  "windows": [
    "message-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "allow-accounts",
    "allow-folders",
    "allow-settings-get",
    "allow-language",
    "allow-extensions",
    "allow-messages-by-id",
    "allow-message-open",
    "allow-thread",
    "allow-set-flag",
    "allow-move-messages",
    "allow-delete-messages",
    "allow-archive",
    "allow-mark-spam",
    "allow-snooze",
    "allow-counters",
    "allow-followup-cancel",
    "allow-followup-postpone",
    "allow-unsubscribe",
    "allow-unsubscribe-plan",
    "allow-trust-sender",
    "allow-avatar",
    "allow-addresses",
    "allow-attachment-open",
    "allow-attachment-bytes",
    "allow-attachment-save",
    "allow-attachment-save-in",
    "allow-attachments-save-all",
    "allow-letter-view",
    "allow-document-html",
    "allow-markdown-html",
    "allow-open-link",
    "allow-send",
    "allow-draft-save",
    "allow-draft-discard",
    "allow-outbox-cancel",
    "allow-temp-attachment",
    "allow-extension-storage-get",
    "allow-extension-storage-set",
    "allow-plugin-settings-set",
    "allow-inline-image",
    "allow-pick-files",
    "allow-pick-folder",
    "allow-pick-save-file"
  ]
}
