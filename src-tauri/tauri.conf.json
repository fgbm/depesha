{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Depesha",
  "mainBinaryName": "depesha",
  "version": "0.6.0",
  "identifier": "ru.depesha.mail",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Депеша",
        "width": 1280,
        "height": 820,
        "minWidth": 520,
        "minHeight": 560,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http:",
        "font-src": "'self' data:",
        "media-src": "'self' blob:",
        "worker-src": "'self' blob:",
        "frame-src": "'self' ext: http://ext.localhost https://ext.localhost",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Почтовый клиент",
    "longDescription": "Депеша — почтовый клиент для любого IMAP/SMTP-сервера: Exchange, Яндекс, Mail.ru, Gmail.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "gnome-keyring | kwalletmanager | keepassxc"
        ],
        "desktopTemplate": "depesha.desktop"
      },
      "appimage": {}
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxQjQwODg4RkMyNjY4NjcKUldSbmFDYjhpQWkwc1VPY2tvTUM5VmhpMWprWlQzTUFMb0Fpajc3SmovRlRETXhGZDV4SkdHOVoK",
      "endpoints": [
        "https://github.com/fgbm/depesha/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
